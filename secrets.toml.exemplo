# Copie este arquivo para .streamlit/secrets.toml (uso local) OU
# cole o conteúdo em "Settings -> Secrets" no Streamlit Community Cloud (produção).
# NUNCA comite o secrets.toml de verdade no Git (adicione ao .gitignore).

OPENAI_API_KEY = "sk-proj-SUBSTITUA_AQUI"

[google_oauth]
client_id     = "SUBSTITUA.apps.googleusercontent.com"
client_secret = "SUBSTITUA_CLIENT_SECRET"
# Deve ser IDÊNTICO à URL do seu app (com a barra final) e também
# cadastrado em "Authorized redirect URIs" no Google Cloud Console.
redirect_uri  = "https://SEU-APP.streamlit.app/"

[google_drive]
root_folder_id = "104KRKkS1hSEfbB6rGfbTpt0kfd0DlyyX"
