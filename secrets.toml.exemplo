# Copie este conteúdo para .streamlit/secrets.toml (uso local) OU cole em
# "Settings > Secrets" no Streamlit Community Cloud (produção).
# NUNCA comite o secrets.toml de verdade no Git.

OPENAI_API_KEY = "sk-proj-SUBSTITUA_AQUI"

# Senha para acessar as áreas "Gestão de estudos" e "Desempenho".
# Quem só vai RESPONDER simulados não precisa dessa senha.
admin_password = "escolha-uma-senha-forte-aqui"

[google_drive]
root_folder_id = "104KRKkS1hSEfbB6rGfbTpt0kfd0DlyyX"

# Token de longa duração da sua conta pessoal do Google (não é mais
# Service Account). Rode "python obter_refresh_token.py CLIENT_ID
# CLIENT_SECRET" no seu computador (uma única vez) pra gerar esses
# valores — veja as instruções no topo desse script.
[google_oauth]
client_id = "SUBSTITUA.apps.googleusercontent.com"
client_secret = "SUBSTITUA"
refresh_token = "SUBSTITUA"
